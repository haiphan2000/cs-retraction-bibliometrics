                \parbox[c][0.5cm][c]{8cm}{
                    \hspace{3pt}\sffamily\bfseries\small RESEARCH
                }
            }
        }
    }

    \fancyfoot[RO]{\raisebox{-0.5\height}{\includegraphics[height=18pt]{figures/common/springer-logo.png}}}

    \renewcommand{\headrulewidth}{0.0pt}
    \renewcommand{\footrulewidth}{0.0pt}
}

