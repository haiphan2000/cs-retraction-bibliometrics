}

\fancypagestyle{firststyle}{
    \fancyhf{}

    \fancyhead[L]{
        \parbox[b]{\headwidth}{
            \robotocondensed \small
            Scientometrics (2026)\\
            https://doi.org/10.1007/s11192-999-test000\\[-2pt]
